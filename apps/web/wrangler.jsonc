{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Top-level is a deliberately non-production default so a bare `wrangler deploy`
  // (no environment selected) can never land on the live `lmgroktfy` Worker and
  // collide on the lmgroktfy.com custom domain. Real deploys always select an
  // environment: `[env.staging]` or `[env.production]` (see package.json deploy scripts).
  "name": "lmgroktfy-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  },

  "env": {
    "staging": {
      // Staging serves on the dev.lmgroktfy.com custom domain, not workers.dev: Turnstile
      // refuses to issue a widget for the shared *.workers.dev zone, so a real staging
      // challenge needs a registered domain. Verified before promoting production in place.
      "name": "lmgroktfy-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "dev.lmgroktfy.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "staging"
        // TURNSTILE_SITE_KEY (public) is baked at build time by the Turnstile unit, not a
        // runtime var (the widget renders on prerendered pages). Staging widget sitekey
        // 0x4AAAAAAEAmF7QdqUEQKt7L (1Password: "lmgroktfy Turnstile (staging)").
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          // Distinct from production so the two Workers never share a limiter while both exist.
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "kv_namespaces": [{ "binding": "ANSWER_CACHE", "id": "ae8ae20fb2c840389761fc814567dab7" }]
    },

    "production": {
      // MUST stay "lmgroktfy": `--env production` then lands on the existing production
      // Worker that already holds the live bindings and custom domains, rather than
      // creating a new `lmgroktfy-production` Worker that collides on lmgroktfy.com.
      "name": "lmgroktfy",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "lmgroktfy.com", "custom_domain": true },
        { "pattern": "www.lmgroktfy.com", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production"
        // TURNSTILE_SITE_KEY (public) is baked at build time by the Turnstile unit, not a
        // runtime var. Production widget sitekey 0x4AAAAAAEAmHJj54x5mc02v
        // (1Password: "lmgroktfy Turnstile (production)").
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "kv_namespaces": [{ "binding": "ANSWER_CACHE", "id": "766e516a0b524d67945944b07519dc52" }]
    }
  }
}
