{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Top-level is a deliberately non-production default so a bare `wrangler deploy`
  // (no environment selected) can never land on the live `lmgroktfy` Worker and
  // collide on the lmgroktfy.com custom domain. Real deploys always select an
  // environment: `[env.staging]` or `[env.production]` (see package.json deploy scripts).
  "name": "lmgroktfy-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  },

  "env": {
    "staging": {
      // workers.dev preview target; verified before promoting production in place.
      "name": "lmgroktfy-staging",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging"
        // TURNSTILE_SITE_KEY (the public Turnstile site key) is per-environment and belongs in this block.
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          // Distinct from production so the two Workers never share a limiter while both exist.
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
      // kv_namespaces: this environment's answer-cache namespace binding belongs here; its
      // id is provisioned separately and must differ from the other environment's.
    },

    "production": {
      // MUST stay "lmgroktfy": `--env production` then lands on the existing production
      // Worker that already holds the live bindings and custom domains, rather than
      // creating a new `lmgroktfy-production` Worker that collides on lmgroktfy.com.
      "name": "lmgroktfy",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "lmgroktfy.com", "custom_domain": true },
        { "pattern": "www.lmgroktfy.com", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production"
        // TURNSTILE_SITE_KEY (the public Turnstile site key) is per-environment and belongs in this block.
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
      // kv_namespaces: this environment's answer-cache namespace binding belongs here; its
      // id is provisioned separately and must differ from the other environment's.
    }
  }
}
