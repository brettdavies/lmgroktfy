# Per-repo release values, sourced by scripts/release/_lib.sh. preflight,
# postflight and sync-dev are separate entry points, so a value declared in one
# script is missing from the other two; this file is the one place all three
# read.

# The deployed Workers surface-smoke targets (the custom domains in
# apps/web/wrangler.jsonc). preflight.sh smokes staging; postflight.sh picks
# one by --env. --staging-url / --prod-url override them per run.
STAGING_URL_DEFAULT="https://dev.lmgroktfy.com"
PROD_URL_DEFAULT="https://lmgroktfy.com"
