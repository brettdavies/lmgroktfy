#!/usr/bin/env bash
# Local CI mirror — the whole-repo pre-push gate. Runs the same checks as
# .github/workflows/test.yml (lint, typecheck, build, tests), so a push that
# survives the hook passes CI and a push that fails it would have failed CI
# anyway, just slower. This is the compensating control for CI running one
# pull_request check per change; it reproduces CI's verdict before the network
# round-trip and is the only remote-equivalent check for code that never opens
# a PR. Its fast, staged-scoped companion is scripts/hooks/pre-commit.
#
# Activate per clone via: git config core.hooksPath scripts/hooks
# core.hooksPath is machine-local git config: it does not travel with the clone
# and is not enforced by cloning. An unset core.hooksPath is the most common
# reason a tracked hook never fires. Run the command above once per fresh clone
# (see README "Local hooks").
#
# Assumes dependencies are installed (bun install). The lint/typecheck/build/
# test steps do not skip: their tools ship with the repo toolchain, and a
# missing one means the toolchain itself is broken. actionlint and shellcheck
# skip-with-hint when absent, so the hook never blocks a push on an
# under-provisioned machine — but every skip echoes what it skipped and why.
#
# Exit codes: 0 = all pass or nothing to check (the push only deletes),
# 1 = failure.
# Requires bash >= 4.4 (mapfile).
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

pass() { echo -e "  ${GREEN}✓${RESET} $1"; }
fail() {
  echo -e "  ${RED}✗${RESET} $1"
  exit 1
}

# Git writes one line per pushed ref on stdin,
# `<local ref> <local sha> <remote ref> <remote sha>`, with an all-zero local
# sha for a delete. A push that only deletes delivers no commit, so none of the
# checks below has anything to verify. Git closes stdin once the lines are
# written, but a wrapper can hold it open, so each read is bounded. A terminal
# (the hook run by hand), no ref lines, or a timeout runs every check.
PRE_PUSH_STDIN_TIMEOUT="${PRE_PUSH_STDIN_TIMEOUT:-5}"

push_only_deletes() {
  local line local_sha status saw_delete=false saw_content=false
  [ -t 0 ] && return 1
  while true; do
    status=0
    IFS= read -r -t "$PRE_PUSH_STDIN_TIMEOUT" line || status=$?
    # read exits above 128 when it times out.
    [ "$status" -gt 128 ] && return 1
    read -r _ local_sha _ <<<"$line"
    if [[ $local_sha =~ ^0+$ ]]; then
      saw_delete=true
    elif [ -n "$local_sha" ]; then
      saw_content=true
    fi
    [ "$status" -eq 0 ] || break
  done
  [ "$saw_delete" = true ] && [ "$saw_content" = false ]
}

if push_only_deletes; then
  echo "Nothing to check: the push only deletes."
  exit 0
fi

echo -e "${BOLD}Running local CI checks...${RESET}"

command -v bun >/dev/null 2>&1 || fail "bun not installed (https://bun.sh)"
pass "bun ($(bun --version))"

# 1. Lint (Biome). CI mirror: test.yml "Lint" step (bun run lint).
bun run lint || fail "bun run lint"
pass "lint"

# 2. Format check (Prettier, incl. .astro via prettier-plugin-astro). apps/web
# is excluded from Biome, so Prettier owns its formatting. CI mirror: test.yml
# "Format check" step.
bun run format:check || fail "bun run format:check"
pass "format"

# 3. Type check: tsc over packages/shared, astro check over apps/web. CI mirror:
# test.yml "Type check" step.
bun run typecheck || fail "bun run typecheck"
pass "typecheck"

# 4. Build shared + the Astro app. CI mirror: test.yml "Build" step.
bun run build || fail "bun run build"
pass "build"

# 5. Unit tests (packages + app). CI mirror: test.yml "Unit tests" step.
bun run test:all || fail "bun run test:all"
pass "test"

# 6. End-to-end (Playwright). CI mirror: test.yml "End-to-end tests" step. The
# build above produced the dist the harness serves; browsers are system-provided
# (never run `playwright install` locally).
bun run test:e2e || fail "bun run test:e2e"
pass "e2e"

# 7. Workflow lint — actionlint over .github/workflows. Skip-with-hint.
if command -v actionlint >/dev/null 2>&1; then
  actionlint || fail "actionlint"
  pass "actionlint"
else
  echo "  - actionlint (skipped: install via \`brew install actionlint\`)"
fi

# 8. Shell lint — shellcheck over tracked shell scripts and the hooks
# themselves. Severity "warning" catches real bugs while ignoring style noise.
if command -v shellcheck >/dev/null 2>&1; then
  mapfile -t shell_files < <({
    git ls-files '*.sh' 2>/dev/null
    git ls-files 'scripts/hooks/*' 2>/dev/null
  } | sort -u)
  if [ ${#shell_files[@]} -gt 0 ]; then
    shellcheck --severity=warning "${shell_files[@]}" || fail "shellcheck --severity=warning"
  fi
  pass "shellcheck"
else
  echo "  - shellcheck (skipped: install via \`brew install shellcheck\`)"
fi

echo -e "${BOLD}${GREEN}All checks passed.${RESET}"
